# Postgres gratuito (es. Neon: https://neon.tech). Formato tipico:
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=""

# Genera un valore casuale con: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
# In locale: http://localhost:3000 — in produzione: l'URL pubblico del servizio (es. Render).
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary gratuito (https://cloudinary.com) per l'hosting delle foto delle carte.
# Si trovano nella dashboard Cloudinary, sezione "Product Environment credentials".
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Brevo (https://brevo.com, gratuito) per l'invio dei codici di verifica email via API
# HTTP — non SMTP, per evitare i blocchi sulle porte SMTP in uscita di molti host gratuiti.
# BREVO_API_KEY si genera dalla dashboard Brevo (SMTP & API > API Keys).
# EMAIL_FROM_ADDRESS deve essere verificato come mittente su Brevo (basta un'email di
# conferma, non serve possedere un dominio).
EMAIL_FROM_ADDRESS=""
BREVO_API_KEY=""

# Google AdSense (opzionale, lascia tutto vuoto finché non hai un account approvato).
# Client ID formato "ca-pub-XXXXXXXXXXXXXXXX", trovi gli slot ID creando due unità
# annuncio nella dashboard AdSense (una per il banner, una per il box).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=""
NEXT_PUBLIC_ADSENSE_SLOT_BOX=""
