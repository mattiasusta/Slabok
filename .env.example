# Postgres gratuito (es. Neon: https://neon.tech). Formato tipico:
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=""

# Genera un valore casuale con: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
# In locale: http://localhost:3000 — in produzione: l'URL pubblico del servizio (es. Render).
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary gratuito (https://cloudinary.com) per l'hosting delle foto delle carte.
# Si trovano nella dashboard Cloudinary, sezione "Product Environment credentials".
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ID publisher Google AdSense (opzionale, lascia vuoto in sviluppo)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
